# Copy this file to .env (next to where you run bootstrap.sh) and adjust it,
# or point to another file with: ./bootstrap.sh --env-file /path/to/file.env
#
# Priority (highest first): command-line arguments > environment variables >
# this file > built-in defaults. Lines starting with # are comments.

ADMIN_USER=admin
ROOTLESS_USER=app
# Optional: fixed UID/GID for the rootless user, to match `user:` in compose
# files (e.g. `user: "1000:1000"`). Empty = auto-assigned by useradd.
# Changing the UID of an existing user requires deleting and recreating it.
# ROOTLESS_UID=1000
# ROOTLESS_GID=1000
SSH_PORT=22
ENABLE_DOCKER_COMPAT=false
INSTALL_PACKAGES=true
# Optional: public key file installed for the admin user before SSH is enabled
# SSH_KEY_FILE=/home/you/.ssh/id_ed25519.pub
# Optional: also allow SSH login for the rootless user (forwarding disabled).
# By default the rootless user is denied SSH login (DenyUsers).
# Must be a DIFFERENT key than SSH_KEY_FILE (the script refuses shared keys).
# ROOTLESS_SSH_KEY_FILE=/home/you/.ssh/app_id_ed25519.pub
