# Copy this file to .env (next to where you run bootstrap.sh) and adjust it,
# or point to another file with: ./bootstrap.sh --env-file /path/to/file.env
#
# Priority (highest first): command-line arguments > environment variables >
# this file > built-in defaults. Lines starting with # are comments.

ADMIN_USER=admin
ROOTLESS_USER=app
SSH_PORT=22
ENABLE_DOCKER_COMPAT=false
INSTALL_PACKAGES=true
# Optional: public key file installed for the admin user before SSH is enabled
# SSH_KEY_FILE=/home/you/.ssh/id_ed25519.pub
